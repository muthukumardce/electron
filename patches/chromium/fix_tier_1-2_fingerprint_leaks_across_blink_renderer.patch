+DOMRectReadOnly* IntersectionObserverEntry::rootBoundsForBinding(
+    ScriptState* script_state) const {
+  DOMRectReadOnly* result = rootBounds();
+  if (!result)
+    return result;
+  auto* storage = GetSessionOverrideStorage(script_state);
+  if (storage && storage->override_dom_seed.has_value() &&
+      !storage->IsOverrideDisabled("dom.intersectionObserver")) {
+    double seed = storage->override_dom_seed.value();
+    return DOMRectReadOnly::Create(
+        result->x() + (SeededNoise(seed, 35) - 0.5) * 0.001,
+        result->y() + (SeededNoise(seed, 36) - 0.5) * 0.001,
+        result->width() + (SeededNoise(seed, 37) - 0.5) * 0.001,
+        result->height() + (SeededNoise(seed, 38) - 0.5) * 0.001);
+  }
+  return result;
+}
