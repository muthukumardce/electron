+DOMHighResTimeStamp Performance::timeOriginForBinding(
+    ScriptState* script_state) const {
+  double result = timeOrigin();
+  auto* storage = GetSessionOverrideStorage(script_state);
+  if (storage && !storage->IsOverrideDisabled("performance.timeOrigin") &&
+      storage->override_performance_seed.has_value()) {
+    double seed = storage->override_performance_seed.value();
+    // Add deterministic offset (±50ms) to prevent cross-tab correlation
+    result += (SeededNoise(seed, 4) - 0.5) * 100.0;
+  }
+  return result;
+}
