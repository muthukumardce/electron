 }
 
+DOMRectList* Range::getClientRectsForBinding(
+    ScriptState* script_state) const {
+  DOMRectList* result = getClientRects();
+  if (!result || result->length() == 0)
+    return result;
+  auto* storage = GetSessionOverrideStorage(script_state);
+  if (storage && storage->override_dom_seed.has_value() &&
+      !storage->IsOverrideDisabled("dom.getClientRects")) {
+    double seed = storage->override_dom_seed.value();
+    for (unsigned i = 0; i < result->length(); ++i) {
+      DOMRect* r = result->item(i);
+      int base = 40 + static_cast<int>(i) * 4;
+      r->setX(r->x() + (SeededNoise(seed, base) - 0.5) * 0.001);
+      r->setY(r->y() + (SeededNoise(seed, base + 1) - 0.5) * 0.001);
+      r->setWidth(r->width() + (SeededNoise(seed, base + 2) - 0.5) * 0.001);
+      r->setHeight(r->height() +
+                   (SeededNoise(seed, base + 3) - 0.5) * 0.001);
+    }
+  }
+  return result;
+}
+
