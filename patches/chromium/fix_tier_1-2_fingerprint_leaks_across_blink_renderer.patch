 // Helper to parse a double from a WTF::String.
+// Handles "inf"/"-inf" from std::to_string(infinity) which WTF::ToDouble rejects.
 std::optional<double> ParseDouble(const String& s) {
+  if (EqualIgnoringASCIICase(s, "inf") || EqualIgnoringASCIICase(s, "infinity"))
+    return std::numeric_limits<double>::infinity();
+  if (s.StartsWith("-") &&
+      (EqualIgnoringASCIICase(s.Substring(1), "inf") ||
+       EqualIgnoringASCIICase(s.Substring(1), "infinity")))
+    return -std::numeric_limits<double>::infinity();
   bool ok = false;
   double val = s.ToDouble(&ok);
   return ok ? std::optional<double>(val) : std::nullopt;
