       !storage->IsOverrideDisabled("audio")) {
     double seed = storage->override_audio_seed.value();
-    float* data = array->Data();
-    for (unsigned i = 0; i < array->length(); i++) {
-      data[i] += static_cast<float>((SeededNoise(seed, i) - 0.5) * 0.0001);
+    auto span = array->AsSpan();
+    for (unsigned i = 0; i < span.size(); i++) {
+      span[i] += static_cast<float>((SeededNoise(seed, i) - 0.5) * 0.0001);
     }
   }
 }
