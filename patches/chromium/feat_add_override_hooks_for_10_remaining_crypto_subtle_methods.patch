+template <typename T>
+std::optional<ScriptPromise<T>> MaybeSubtleCryptoOverride(
+    ScriptState* script_state,
+    const char* override_name) {
+  if (!script_state || !script_state->ContextIsValid())
+    return std::nullopt;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+
+  v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+      script_state, "subtleCrypto", override_name);
+  if (override_fn.IsEmpty())
+    return std::nullopt;
+
+  v8::Local<v8::Context> context = script_state->GetContext();
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> override_result;
+  if (!V8ScriptRunner::CallFunction(
+           override_fn, ExecutionContext::From(script_state),
+           context->Global(), 0, nullptr, isolate)
+           .ToLocal(&override_result)) {
+    if (try_catch.HasCaught()) {
+      v8::Local<v8::Promise::Resolver> v8_resolver;
+      if (v8::Promise::Resolver::New(context).ToLocal(&v8_resolver)) {
+        v8_resolver->Reject(context, try_catch.Exception()).Check();
+        return ScriptPromise<T>::FromV8Promise(
+            isolate, v8_resolver->GetPromise());
+      }
+    }
+    return std::nullopt;
+  }
+
+  v8::Local<v8::Promise::Resolver> v8_resolver;
+  if (v8::Promise::Resolver::New(context).ToLocal(&v8_resolver)) {
+    v8_resolver->Resolve(context, override_result).Check();
+    return ScriptPromise<T>::FromV8Promise(
+        isolate, v8_resolver->GetPromise());
+  }
+  return std::nullopt;
+}
+
 }  // namespace
 
 SubtleCrypto::SubtleCrypto() = default;
