+// Wraps a symbol-keyed function (e.g. Symbol.toPrimitive) on a target object.
+bool WrapSymbolFunctionOnObject(v8::Isolate* isolate,
+                                v8::Local<v8::Context> context,
+                                v8::Local<v8::Object> target,
+                                v8::Local<v8::Symbol> symbol_key,
+                                const char* display_name,
+                                const char* interface_key,
+                                const char* override_name) {
+  v8::Local<v8::Value> original_val;
+  if (!target->Get(context, symbol_key).ToLocal(&original_val) ||
+      !original_val->IsFunction()) {
+    return false;
+  }
+  v8::Local<v8::Function> original_fn = original_val.As<v8::Function>();
+
+  v8::Local<v8::Value> data_items[] = {
+      original_fn,
+      V8AtomicString(isolate, interface_key),
+      V8AtomicString(isolate, override_name),
+  };
+  v8::Local<v8::Array> data = v8::Array::New(isolate, data_items, 3);
+
+  int fn_length = 0;
+  v8::Local<v8::Value> length_val;
+  if (original_fn->Get(context, V8AtomicString(isolate, "length"))
+           .ToLocal(&length_val) &&
+      length_val->IsInt32()) {
+    fn_length = length_val.As<v8::Int32>()->Value();
+  }
+
+  v8::Local<v8::Function> wrapper;
+  if (!v8::Function::New(context, GenericBuiltinWrapper, data, fn_length)
+           .ToLocal(&wrapper)) {
+    return false;
+  }
+
+  wrapper->SetName(V8AtomicString(isolate, display_name));
+  return target->Set(context, symbol_key, wrapper).FromMaybe(false);
+}
+
+// Wraps a constructor on the global object (Pattern X).
+// Copies prototype and own properties from original to wrapper.
+bool WrapConstructorOnGlobal(v8::Isolate* isolate,
+                             v8::Local<v8::Context> context,
+                             v8::Local<v8::Object> global,
+                             const char* ctor_name,
+                             const char* interface_key,
+                             const char* override_name) {
+  v8::Local<v8::String> name_str = V8AtomicString(isolate, ctor_name);
+  v8::Local<v8::Value> original_val;
+  if (!global->Get(context, name_str).ToLocal(&original_val) ||
+      !original_val->IsFunction()) {
+    return false;
+  }
+  v8::Local<v8::Function> original_fn = original_val.As<v8::Function>();
+
+  v8::Local<v8::Value> data_items[] = {
+      original_fn,
+      V8AtomicString(isolate, interface_key),
+      V8AtomicString(isolate, override_name),
+  };
+  v8::Local<v8::Array> data = v8::Array::New(isolate, data_items, 3);
+
+  int fn_length = 0;
+  v8::Local<v8::Value> length_val;
+  if (original_fn->Get(context, V8AtomicString(isolate, "length"))
+           .ToLocal(&length_val) &&
+      length_val->IsInt32()) {
+    fn_length = length_val.As<v8::Int32>()->Value();
+  }
+
+  v8::Local<v8::Function> wrapper;
+  if (!v8::Function::New(context, GenericConstructorWrapper, data, fn_length)
+           .ToLocal(&wrapper)) {
+    return false;
+  }
+
+  wrapper->SetName(name_str);
+
+  // Share prototype so instanceof works.
+  v8::Local<v8::Value> proto;
+  if (original_fn->Get(context, V8AtomicString(isolate, "prototype"))
+           .ToLocal(&proto)) {
+    wrapper->Set(context, V8AtomicString(isolate, "prototype"), proto).Check();
+    if (proto->IsObject()) {
+      proto.As<v8::Object>()
+          ->Set(context, V8AtomicString(isolate, "constructor"), wrapper)
+          .Check();
+    }
+  }
+
+  // Copy own properties from original to wrapper (static methods, constants).
+  v8::Local<v8::String> skip_props[] = {
+      V8AtomicString(isolate, "prototype"),
+      V8AtomicString(isolate, "length"),
+      V8AtomicString(isolate, "name"),
+      V8AtomicString(isolate, "arguments"),
+      V8AtomicString(isolate, "caller"),
+  };
+  v8::Local<v8::Array> prop_names;
+  if (original_fn->GetOwnPropertyNames(context).ToLocal(&prop_names)) {
+    for (uint32_t i = 0; i < prop_names->Length(); i++) {
+      v8::Local<v8::Value> key;
+      if (!prop_names->Get(context, i).ToLocal(&key))
+        continue;
+      bool skip = false;
+      for (const auto& s : skip_props) {
+        if (key->StrictEquals(s)) {
+          skip = true;
+          break;
+        }
+      }
+      if (skip)
+        continue;
+      v8::Local<v8::Value> val;
+      if (original_fn->Get(context, key).ToLocal(&val)) {
+        wrapper->Set(context, key, val).FromMaybe(false);
+      }
+    }
+  }
+
+  return global->Set(context, name_str, wrapper).FromMaybe(false);
+}
