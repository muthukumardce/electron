+
+// Install Function.prototype.toString override.
+void InstallFunctionOverrides(v8::Isolate* isolate,
+                              v8::Local<v8::Context> context) {
+  v8::Local<v8::Object> global = context->Global();
+  v8::Local<v8::Value> function_val;
+  if (!global->Get(context, V8AtomicString(isolate, "Function"))
+           .ToLocal(&function_val) ||
+      !function_val->IsFunction()) {
+    return;
+  }
+  v8::Local<v8::Value> proto_val;
+  if (!function_val.As<v8::Object>()
+           ->Get(context, V8AtomicString(isolate, "prototype"))
+           .ToLocal(&proto_val) ||
+      !proto_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Object> proto = proto_val.As<v8::Object>();
+
+  WrapFunctionOnObject(isolate, context, proto, "toString", "function",
+                       "toStringOverride");
+}
+
+// Install constructor wrappers (Pattern X) for Error types, Notification, etc.
+void InstallConstructorOverrides(v8::Isolate* isolate,
+                                 v8::Local<v8::Context> context) {
+  v8::Local<v8::Object> global = context->Global();
+
+  static const struct {
+    const char* ctor_name;
+    const char* interface_key;
+    const char* override_name;
+  } kCtors[] = {
+      {"Error", "error", "constructorOverride"},
+      {"TypeError", "error", "typeErrorConstructorOverride"},
+      {"RangeError", "error", "rangeErrorConstructorOverride"},
+      {"SyntaxError", "error", "syntaxErrorConstructorOverride"},
+      {"Notification", "notification", "constructorOverride"},
+      {"FontFace", "fontFace", "constructorOverride"},
+  };
+
+  for (const auto& ctor : kCtors) {
+    WrapConstructorOnGlobal(isolate, context, global, ctor.ctor_name,
+                            ctor.interface_key, ctor.override_name);
+  }
 }
 
