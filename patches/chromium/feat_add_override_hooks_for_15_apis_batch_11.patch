diff --git a/third_party/blink/renderer/core/css/font_face_set.cc b/third_party/blink/renderer/core/css/font_face_set.cc
index a48ed608fcdad57fc4e605a2c87c19a5abe25cef..74f1a7efa7d6d976c6bf4e304ab13c41c66adb97 100644
--- a/third_party/blink/renderer/core/css/font_face_set.cc
+++ b/third_party/blink/renderer/core/css/font_face_set.cc
@@ -230,6 +230,28 @@ ScriptPromise<IDLSequence<FontFace>> FontFaceSet::load(
   return promise;
 }
 
+ScriptPromise<IDLSequence<FontFace>> FontFaceSet::loadForBinding(
+    ScriptState* script_state,
+    const String& font_string,
+    const String& text) {
+  if (script_state && script_state->ContextIsValid()) {
+    v8::Isolate* isolate = script_state->GetIsolate();
+    v8::HandleScope handle_scope(isolate);
+    v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+        script_state, "fontFaceSet", "loadOverride");
+    if (!override_fn.IsEmpty()) {
+      v8::TryCatch try_catch(isolate);
+      v8::Local<v8::Value> override_result;
+      if (override_fn
+              ->Call(script_state->GetContext(), v8::Undefined(isolate), 0,
+                     nullptr)
+              .ToLocal(&override_result)) {
+      }
+    }
+  }
+  return load(script_state, font_string, text);
+}
