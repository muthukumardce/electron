+++ b/third_party/blink/renderer/core/frame/local_dom_window.cc
@@ -1085,6 +1085,32 @@ MediaQueryList* LocalDOMWindow::matchMedia(const String& media) {
   return document()->GetMediaQueryMatcher().MatchMedia(media);
 }
 
+MediaQueryList* LocalDOMWindow::matchMediaForBinding(ScriptState* script_state,
+                                                     const String& media) {
+  MediaQueryList* result = matchMedia(media);
+  if (!result || !script_state || !script_state->ContextIsValid())
+    return result;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+
+  v8::Local<v8::Function> override_fn =
+      GetCustomOverrideFunction(script_state, "window", "matchMediaOverride");
+  if (override_fn.IsEmpty())
+    return result;
+
+  v8::Local<v8::Context> context = script_state->GetContext();
+  v8::Local<v8::Value> result_value =
+      ToV8Traits<MediaQueryList>::ToV8(script_state, result);
+  v8::Local<v8::Value> argv[] = {result_value};
+  v8::TryCatch try_catch(isolate);
+  std::ignore = V8ScriptRunner::CallFunction(
+      override_fn, ExecutionContext::From(script_state),
+      context->Global(), 1, argv, isolate);
+  return result;
+}
