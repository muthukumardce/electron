+ScriptValue WebGL2RenderingContextBase::getInternalformatParameterForBinding(
+    ScriptState* script_state,
+    GLenum target,
+    GLenum internalformat,
+    GLenum pname) {
+  ScriptValue result =
+      getInternalformatParameter(script_state, target, internalformat, pname);
+  if (!script_state || !script_state->ContextIsValid())
+    return result;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+
+  v8::Local<v8::Function> override_fn =
+      GetCustomOverrideFunction(script_state, "webgl2RenderingContext",
+                                "getInternalformatParameterOverride");
+  if (override_fn.IsEmpty())
+    return result;
+
+  v8::Local<v8::Context> context = script_state->GetContext();
+  v8::Local<v8::Value> argv[] = {result.V8Value()};
+  v8::TryCatch try_catch(isolate);
