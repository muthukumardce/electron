+++ b/third_party/blink/renderer/bindings/core/v8/local_window_proxy.cc
@@ -208,6 +208,14 @@ void LocalWindowProxy::Initialize() {
     SetSecurityToken(origin.get());
   }
 
+  // Install __ro/__rov/__rUA bridge BEFORE DidCreateScriptContext.
+  // DidCreateScriptContext triggers Electron to create the isolated world
+  // and run the preload, which calls contextBridge.executeInMainWorld()
+  // to register overrides via these bridge functions.
+  if (World().IsMainWorld()) {
+    InstallOverrideBridge(script_state_);
+  }
+
   {
     TRACE_EVENT2("v8", "ContextCreatedNotification", "IsMainFrame",
                  GetFrame()->IsMainFrame(), "IsOutermostMainFrame",
@@ -220,7 +228,8 @@ void LocalWindowProxy::Initialize() {
   InstallConditionalFeatures();
   GetFrame()->Client()->DidInstallConditionalFeatures(context, world_->GetWorldId());
 
-  // Install V8 built-in override wrappers (Math, Date, etc.) - main world only.
+  // Install V8 built-in wrappers (Math, Date, etc.) AFTER preload has
+  // registered overrides via the bridge.
   if (World().IsMainWorld()) {
     InstallV8BuiltinOverrides(script_state_);
   }
