-String NavigatorBase::userAgent() const {
+String NavigatorBase::userAgent(ScriptState* script_state) const {
   ExecutionContext* execution_context = GetExecutionContext();
-  return execution_context ? execution_context->UserAgent() : String();
+  String user_agent = execution_context ? execution_context->UserAgent() : String();
+
+  if (!script_state || !script_state->ContextIsValid() || !execution_context) {
+    return user_agent;
+  }
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+  v8::Local<v8::Context> context = script_state->GetContext();
+
+  v8::Local<v8::Value> navigator_value =
+      ToV8Traits<NavigatorBase>::ToV8(script_state,
+                                      const_cast<NavigatorBase*>(this));
+  if (navigator_value.IsEmpty() || !navigator_value->IsObject()) {
+    return user_agent;
+  }
+  v8::Local<v8::Object> navigator_object =
+      navigator_value.As<v8::Object>();
+
+  v8::Local<v8::Value> override_value;
+  if (!navigator_object
+           ->Get(context, V8AtomicString(isolate, "userAgentOverride"))
+           .ToLocal(&override_value) ||
+      !override_value->IsFunction()) {
+    return user_agent;
+  }
+
+  v8::Local<v8::Value> argv[] = {V8String(isolate, user_agent)};
+  v8::Local<v8::Value> override_result;
+  if (!V8ScriptRunner::CallFunction(
+           override_value.As<v8::Function>(), execution_context,
+           navigator_object, 1, argv, isolate)
+           .ToLocal(&override_result)) {
+    return user_agent;
+  }
+
+  if (override_result->IsNullOrUndefined()) {
+    return user_agent;
+  }
+
+  v8::Local<v8::String> override_string;
+  if (!override_result->ToString(context).ToLocal(&override_string)) {
+    return user_agent;
+  }
+  return ToCoreString(isolate, override_string);
 }
 
