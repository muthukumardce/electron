-NavigatorUAData* NavigatorUA::userAgentData() {
+namespace {
+
+NavigatorUAData* ApplyUserAgentDataOverride(ScriptState* script_state,
+                                            ExecutionContext* execution_context,
+                                            NavigatorUAData* ua_data) {
+  if (!script_state || !script_state->ContextIsValid() || !execution_context) {
+    return ua_data;
+  }
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+  v8::Local<v8::Context> context = script_state->GetContext();
+
+  v8::Local<v8::Value> navigator_value;
+  if (!context->Global()
+           ->Get(context, V8AtomicString(isolate, "navigator"))
+           .ToLocal(&navigator_value) ||
+      !navigator_value->IsObject()) {
+    return ua_data;
+  }
+
+  v8::Local<v8::Object> navigator_object = navigator_value.As<v8::Object>();
+  v8::Local<v8::Value> override_value;
+  if (!navigator_object
+           ->Get(context, V8AtomicString(isolate, "userAgentDataOverride"))
+           .ToLocal(&override_value) ||
+      !override_value->IsFunction()) {
+    return ua_data;
+  }
+
+  v8::Local<v8::Value> argv[] = {
+      ToV8Traits<NavigatorUAData>::ToV8(script_state, ua_data)};
+  v8::Local<v8::Value> override_result;
+  if (!V8ScriptRunner::CallFunction(override_value.As<v8::Function>(),
+                                    execution_context, navigator_object, 1,
+                                    argv, isolate)
+           .ToLocal(&override_result)) {
+    return ua_data;
+  }
+
+  if (override_result->IsNullOrUndefined() || !override_result->IsObject()) {
+    return ua_data;
+  }
+
+  const WrapperTypeInfo* wrapper_type_info =
+      NavigatorUAData::GetStaticWrapperTypeInfo();
+  if (!V8PerIsolateData::From(isolate)->HasInstance(wrapper_type_info,
+                                                    override_result)) {
+    return ua_data;
+  }
+
+  return ToScriptWrappable<NavigatorUAData>(
+      isolate, override_result.As<v8::Object>());
+}
+
+}  // namespace
+
+NavigatorUAData* NavigatorUA::userAgentData(ScriptState* script_state) {
   // Return cached instance if it exists
   if (ua_data_) {
-    return ua_data_;
+    return ApplyUserAgentDataOverride(script_state, GetUAExecutionContext(),
+                                      ua_data_);
