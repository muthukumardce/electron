+void NavigatorUAData::setUA(const UAOverrideValues* override_values) {
+  base::UnguessableToken cluster_id = GetAgentClusterId();
+  if (cluster_id.is_empty()) {
+    return;
+  }
+
+  UAOverrideValues_Storage* storage =
+      UAOverrideManager::GetInstance().GetStorageForCluster(cluster_id);
+  if (!storage) {
+    return;
+  }
+
+  if (!override_values) {
+    storage->Reset();
+    return;
+  }
+
+  storage->has_override = true;
+
+  // Override brands - store as pairs of strings
+  if (override_values->hasBrands()) {
+    storage->override_brands.clear();
+    for (const auto& brand : override_values->brands()) {
+      storage->override_brands.push_back(
+          std::make_pair(brand->brand(), brand->version()));
+    }
+  }
+
+  // Override fullVersionList - store as pairs of strings
+  if (override_values->hasFullVersionList()) {
+    storage->override_full_version_list.clear();
+    for (const auto& brand : override_values->fullVersionList()) {
+      storage->override_full_version_list.push_back(
+          std::make_pair(brand->brand(), brand->version()));
+    }
+  }
+
+  // Override mobile
+  if (override_values->hasMobile()) {
+    storage->override_mobile = override_values->mobile();
+  }
+
+  // Override platform
+  if (override_values->hasPlatform()) {
+    storage->override_platform = override_values->platform();
+  }
+
+  // Override platformVersion
+  if (override_values->hasPlatformVersion()) {
+    storage->override_platform_version = override_values->platformVersion();
+  }
+
+  // Override architecture
+  if (override_values->hasArchitecture()) {
+    storage->override_architecture = override_values->architecture();
+  }
+
+  // Override model
+  if (override_values->hasModel()) {
+    storage->override_model = override_values->model();
+  }
+
+  // Override uaFullVersion
+  if (override_values->hasUaFullVersion()) {
+    storage->override_ua_full_version = override_values->uaFullVersion();
+  }
+
+  // Override bitness
+  if (override_values->hasBitness()) {
+    storage->override_bitness = override_values->bitness();
+  }
+
+  // Override wow64
+  if (override_values->hasWow64()) {
+    storage->override_wow64 = override_values->wow64();
+  }
+
+  // Override formFactors
+  if (override_values->hasFormFactors()) {
+    storage->override_form_factors = override_values->formFactors();
+  }
+}
