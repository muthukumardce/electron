+// UAOverrideValues_Storage Reset implementation
+void UAOverrideValues_Storage::Reset() {
+  has_override = false;
+  override_brands.clear();
+  override_full_version_list.clear();
+  override_mobile.reset();
+  override_platform.reset();
+  override_platform_version.reset();
