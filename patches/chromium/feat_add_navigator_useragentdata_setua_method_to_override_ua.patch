+
+// UAOverrideManager singleton - thread-safe for Service Worker access
+UAOverrideManager& UAOverrideManager::GetInstance() {
+  DEFINE_THREAD_SAFE_STATIC_LOCAL(UAOverrideManager, instance, ());
+  return instance;
+}
+
+UAOverrideValues_Storage* UAOverrideManager::GetStorageForCluster(
+    const base::UnguessableToken& cluster_id) {
+  if (cluster_id.is_empty()) {
+    return nullptr;
+  }
+  base::AutoLock auto_lock(lock_);
+  String key = String::FromUTF8(cluster_id.ToString());
+  auto it = storage_map_.find(key);
+  if (it != storage_map_.end()) {
+    return it->value.get();
+  }
+  // Create new storage for this agent cluster
+  auto storage = std::make_unique<UAOverrideValues_Storage>();
+  UAOverrideValues_Storage* ptr = storage.get();
+  storage_map_.insert(key, std::move(storage));
+  return ptr;
+}
+
+void UAOverrideManager::ResetStorageForCluster(
+    const base::UnguessableToken& cluster_id) {
+  if (cluster_id.is_empty()) {
+    return;
+  }
+  base::AutoLock auto_lock(lock_);
+  String key = String::FromUTF8(cluster_id.ToString());
+  auto it = storage_map_.find(key);
+  if (it != storage_map_.end()) {
+    it->value->Reset();
+  }
+}
