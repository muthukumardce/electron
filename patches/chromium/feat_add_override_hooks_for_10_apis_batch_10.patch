+// Calls the override function for a boolean value. If an override is
+// registered, passes the original value and returns the override's boolean
+// result; otherwise returns the original value unchanged.
+inline bool MaybeBoolOverride(ScriptState* script_state,
+                               const char* interface_key,
+                               const char* override_name,
+                               bool value) {
+  if (!script_state || !script_state->ContextIsValid())
+    return value;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+
+  v8::Local<v8::Function> override_fn =
+      GetCustomOverrideFunction(script_state, interface_key, override_name);
+  if (override_fn.IsEmpty())
+    return value;
+
+  v8::Local<v8::Context> context = script_state->GetContext();
+  v8::Local<v8::Value> argv[] = {v8::Boolean::New(isolate, value)};
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> override_result;
+  if (!override_fn
+           ->Call(context, v8::Undefined(isolate), 1, argv)
+           .ToLocal(&override_result))
+    return value;
+
+  if (override_result->IsBoolean())
+    return override_result.As<v8::Boolean>()->Value();
+  return value;
+}
