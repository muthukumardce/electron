 }
 
+PerformanceTiming* Performance::timingForBinding(
+    ScriptState* script_state) const {
+  PerformanceTiming* result = timing();
+  if (!result || !script_state || !script_state->ContextIsValid())
+    return result;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+
+  v8::Local<v8::Function> override_fn =
+      GetCustomOverrideFunction(script_state, "performance",
+                                "timingOverride");
+  if (override_fn.IsEmpty())
+    return result;
+
+  v8::Local<v8::Context> context = script_state->GetContext();
+  v8::Local<v8::Value> result_value =
+      ToV8Traits<PerformanceTiming>::ToV8(script_state, result);
+  v8::Local<v8::Value> argv[] = {result_value};
+  v8::TryCatch try_catch(isolate);
+  std::ignore = V8ScriptRunner::CallFunction(
+      override_fn, ExecutionContext::From(script_state),
+      context->Global(), 1, argv, isolate);
+  return result;
+}
+
+MemoryInfo* Performance::memoryForBinding(ScriptState* script_state) const {
+  MemoryInfo* result = memory(script_state);
+  if (!result || !script_state || !script_state->ContextIsValid())
+    return result;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+
+  v8::Local<v8::Function> override_fn =
+      GetCustomOverrideFunction(script_state, "performance",
+                                "memoryOverride");
+  if (override_fn.IsEmpty())
+    return result;
+
+  v8::Local<v8::Context> context = script_state->GetContext();
+  v8::Local<v8::Value> result_value =
+      ToV8Traits<MemoryInfo>::ToV8(script_state, result);
+  v8::Local<v8::Value> argv[] = {result_value};
+  v8::TryCatch try_catch(isolate);
+  std::ignore = V8ScriptRunner::CallFunction(
+      override_fn, ExecutionContext::From(script_state),
+      context->Global(), 1, argv, isolate);
+  return result;
+}
+
 }  // namespace blink
