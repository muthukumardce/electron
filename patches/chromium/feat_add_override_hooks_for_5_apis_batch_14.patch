+void WebGL2RenderingContextBase::getBufferSubDataForBinding(
+    ScriptState* script_state,
+    GLenum target,
+    int64_t src_byte_offset,
+    MaybeShared<DOMArrayBufferView> dst_data,
+    int64_t dst_offset,
+    GLuint length) {
+  getBufferSubData(target, src_byte_offset, dst_data, dst_offset, length);
+  if (dst_data.Get() && script_state && script_state->ContextIsValid()) {
+    v8::Isolate* isolate = script_state->GetIsolate();
+    v8::HandleScope handle_scope(isolate);
+    v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+        script_state, "webgl2RenderingContext", "getBufferSubDataOverride");
+    if (!override_fn.IsEmpty()) {
+      v8::Local<v8::Value> array_value =
+          ToV8Traits<DOMArrayBufferView>::ToV8(script_state, dst_data.Get());
+      v8::Local<v8::Value> args[] = {array_value};
+      v8::TryCatch try_catch(isolate);
+      std::ignore = override_fn->Call(script_state->GetContext(),
+                                      v8::Undefined(isolate), 1, args);
+    }
+  }
+}
