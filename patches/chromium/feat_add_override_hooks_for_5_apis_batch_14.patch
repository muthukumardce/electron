+void WebGL2RenderingContextBase::readPixelsOffsetForBinding(
+    ScriptState* script_state,
+    GLint x,
+    GLint y,
+    GLsizei width,
+    GLsizei height,
+    GLenum format,
+    GLenum type,
+    int64_t offset) {
+  readPixels(x, y, width, height, format, type, offset);
+  // PBO readPixels - data goes to GPU buffer, no ArrayBufferView to pass.
+  // Notify override only.
+  if (script_state && script_state->ContextIsValid()) {
+    v8::Isolate* isolate = script_state->GetIsolate();
+    v8::HandleScope handle_scope(isolate);
+    v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+        script_state, "webglRenderingContext", "readPixelsOverride");
+    if (!override_fn.IsEmpty()) {
+      v8::TryCatch try_catch(isolate);
+      std::ignore = override_fn->Call(script_state->GetContext(),
+                                      v8::Undefined(isolate), 0, nullptr);
+    }
+  }
+}
