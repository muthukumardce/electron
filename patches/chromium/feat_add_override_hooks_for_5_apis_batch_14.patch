diff --git a/third_party/blink/renderer/core/frame/local_dom_window.cc b/third_party/blink/renderer/core/frame/local_dom_window.cc
index 3dfc01350435dd08c3b4346dc7871edd1448b0b3..92edce05f603e0fc1d731d52364c8382316af85e 100644
--- a/third_party/blink/renderer/core/frame/local_dom_window.cc
+++ b/third_party/blink/renderer/core/frame/local_dom_window.cc
@@ -1203,6 +1203,29 @@ int LocalDOMWindow::orientation() const {
   return orientation;
 }
 
+int LocalDOMWindow::orientationForBinding(ScriptState* script_state) const {
+  int value = orientation();
+  if (!script_state || !script_state->ContextIsValid())
+    return value;
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+  v8::Local<v8::Function> override_fn =
+      GetCustomOverrideFunction(script_state, "window", "orientationOverride");
+  if (override_fn.IsEmpty())
+    return value;
+  v8::Local<v8::Value> argv[] = {v8::Integer::New(isolate, value)};
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> result;
+  if (!override_fn
+           ->Call(script_state->GetContext(), v8::Undefined(isolate), 1, argv)
+           .ToLocal(&result))
+    return value;
+  if (result->IsInt32())
+    return result.As<v8::Int32>()->Value();
+  return value;
+}
