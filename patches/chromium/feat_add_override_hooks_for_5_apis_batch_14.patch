+ScriptPromise<Response> CacheStorage::matchForBinding(
+    ScriptState* script_state,
+    const V8RequestInfo* request,
+    const MultiCacheQueryOptions* options,
+    ExceptionState& exception_state) {
+  if (script_state && script_state->ContextIsValid()) {
+    v8::Isolate* isolate = script_state->GetIsolate();
+    v8::HandleScope handle_scope(isolate);
+    v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+        script_state, "cacheStorage", "matchOverride");
+    if (!override_fn.IsEmpty()) {
+      v8::TryCatch try_catch(isolate);
+      v8::Local<v8::Value> override_result;
+      if (override_fn
+              ->Call(script_state->GetContext(), v8::Undefined(isolate), 0,
+                     nullptr)
+              .ToLocal(&override_result)) {
+      }
+    }
+  }
+  return match(script_state, request, options, exception_state);
+}
