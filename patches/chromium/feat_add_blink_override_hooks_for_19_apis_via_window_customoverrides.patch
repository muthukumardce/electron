+           .ToLocal(&iface) ||
+      !iface->IsObject())
+    return v8::Local<v8::Function>();
+
+  v8::Local<v8::Value> fn;
+  if (!iface.As<v8::Object>()
+           ->Get(context, V8AtomicString(isolate, override_name))
+           .ToLocal(&fn) ||
+      !fn->IsFunction())
+    return v8::Local<v8::Function>();
+
+  return fn.As<v8::Function>();
