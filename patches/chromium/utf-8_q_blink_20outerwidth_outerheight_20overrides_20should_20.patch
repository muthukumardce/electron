diff --git a/third_party/blink/renderer/core/frame/local_dom_window.cc b/third_party/blink/renderer/core/frame/local_dom_window.cc
index 06b6e4c2e0b48c74157cc6ca979fb5ec8533718f..2983cbd17f06aecbaa259af5946fc345ad0869db 100644
--- a/third_party/blink/renderer/core/frame/local_dom_window.cc
+++ b/third_party/blink/renderer/core/frame/local_dom_window.cc
@@ -1618,7 +1618,11 @@ int LocalDOMWindow::outerHeight() const {
   }
 
   // Check Settings override (set via native path from fingerprint config).
-  int override_val = frame->GetSettings()->GetScreenHeightOverride();
+  // outerHeight on a real maximized Chrome window equals screen.availHeight
+  // (= screen.height minus the taskbar), NOT screen.height. Reporting
+  // screen.height here would produce outerHeight == screen.height, which is
+  // only possible for fullscreen/borderless mode — a strong bot signal.
+  int override_val = frame->GetSettings()->GetScreenAvailHeightOverride();
   if (override_val > 0)
     return override_val;
 
@@ -1648,7 +1652,11 @@ int LocalDOMWindow::outerWidth() const {
   }
 
   // Check Settings override (set via native path from fingerprint config).
-  int override_val = frame->GetSettings()->GetScreenWidthOverride();
+  // Match the outerHeight rule: a real maximized Chrome window's outerWidth
+  // equals screen.availWidth (usually identical to screen.width on most
+  // setups, but distinct when there's a side taskbar). Using availWidth is
+  // the conservative correct choice.
+  int override_val = frame->GetSettings()->GetScreenAvailWidthOverride();
   if (override_val > 0)
     return override_val;
 
