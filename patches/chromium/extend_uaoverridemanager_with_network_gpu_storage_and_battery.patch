+  if (override_values->hasConnectionRtt()) {
+    storage->override_connection_rtt = override_values->connectionRtt();
+  }
+  if (override_values->hasConnectionDownlink()) {
+    storage->override_connection_downlink = override_values->connectionDownlink();
+  }
+  if (override_values->hasConnectionSaveData()) {
+    storage->override_connection_save_data = override_values->connectionSaveData();
+  }
+
+  // GPU overrides
+  if (override_values->hasGpuRenderer()) {
+    storage->override_gpu_renderer = override_values->gpuRenderer();
+  }
+  if (override_values->hasGpuVendor()) {
+    storage->override_gpu_vendor = override_values->gpuVendor();
+  }
+
+  // Storage override
+  if (override_values->hasStorageQuota()) {
+    storage->override_storage_quota = override_values->storageQuota();
+  }
