+  // Check Agent-cluster storage first (works in workers)
+  if (script_state && script_state->ContextIsValid()) {
+    ExecutionContext* ctx = ExecutionContext::From(script_state);
+    if (ctx) {
+      auto* storage = UAOverrideManager::GetInstance().GetStorageForCluster(
