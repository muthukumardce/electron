@@ -103,18 +103,102 @@ bool BatteryManager::charging() {
   return battery_status_.Charging();
 }
 
+bool BatteryManager::chargingForBinding(ScriptState* script_state) {
+  if (script_state && script_state->ContextIsValid()) {
+    v8::Isolate* isolate = script_state->GetIsolate();
+    v8::HandleScope handle_scope(isolate);
+    v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+        script_state, "batteryManager", "chargingOverride");
+    if (!override_fn.IsEmpty()) {
+      v8::TryCatch try_catch(isolate);
+      v8::Local<v8::Value> result;
+      if (override_fn
+              ->Call(script_state->GetContext(), v8::Undefined(isolate), 0,
+                     nullptr)
+              .ToLocal(&result) &&
+          result->IsBoolean()) {
+        return result.As<v8::Boolean>()->Value();
+      }
+    }
+  }
+  return charging();
+}
