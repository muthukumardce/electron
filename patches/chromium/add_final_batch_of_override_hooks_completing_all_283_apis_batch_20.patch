+  // 1. EventTarget.prototype.dispatchEvent (Pattern V).
+  {
+    v8::Local<v8::Value> et_val;
+    if (global
+            ->Get(context, V8AtomicString(isolate, "EventTarget"))
+            .ToLocal(&et_val) &&
+        et_val->IsFunction()) {
+      v8::Local<v8::Value> proto_val;
+      if (et_val.As<v8::Object>()
+              ->Get(context, V8AtomicString(isolate, "prototype"))
+              .ToLocal(&proto_val) &&
+          proto_val->IsObject()) {
+        WrapFunctionOnObject(isolate, context, proto_val.As<v8::Object>(),
+                              "dispatchEvent", "eventTarget",
+                              "dispatchEventOverride");
