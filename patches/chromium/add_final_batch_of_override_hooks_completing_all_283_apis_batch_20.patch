+// Batch 20: Override property getter callback.
+// Used for adding new properties whose values come from customOverrides.
+// data array: [interface_key_string, override_name_string]
+void OverridePropertyGetter(v8::Local<v8::Name> property,
+                             const v8::PropertyCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+  v8::Local<v8::Object> global = context->Global();
+
+  v8::Local<v8::Array> data = info.Data().As<v8::Array>();
+  v8::Local<v8::String> iface_key =
+      data->Get(context, 0u).ToLocalChecked().As<v8::String>();
+  v8::Local<v8::String> override_name =
+      data->Get(context, 1u).ToLocalChecked().As<v8::String>();
+
+  v8::Local<v8::Value> co_val;
+  if (!global
+           ->Get(context, V8AtomicString(isolate, "customOverrides"))
+           .ToLocal(&co_val) ||
+      !co_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Value> iface_val;
+  if (!co_val.As<v8::Object>()
+           ->Get(context, iface_key)
+           .ToLocal(&iface_val) ||
+      !iface_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Value> override_val;
+  if (!iface_val.As<v8::Object>()
+           ->Get(context, override_name)
+           .ToLocal(&override_val) ||
+      override_val->IsUndefined()) {
+    return;
+  }
+
+  if (override_val->IsFunction()) {
+    v8::TryCatch try_catch(isolate);
+    v8::Local<v8::Value> result;
+    if (override_val.As<v8::Function>()
+            ->Call(context, v8::Undefined(isolate), 0, nullptr)
+            .ToLocal(&result) &&
+        !result->IsUndefined()) {
+      info.GetReturnValue().Set(result);
+    }
+  } else {
+    info.GetReturnValue().Set(override_val);
+  }
+}
+
+// Installs a native data property backed by an override getter.
+bool InstallOverrideProperty(v8::Isolate* isolate,
+                              v8::Local<v8::Context> context,
+                              v8::Local<v8::Object> target,
+                              const char* prop_name,
+                              const char* interface_key,
+                              const char* override_name) {
+  v8::Local<v8::Value> data_items[] = {
+      V8AtomicString(isolate, interface_key),
+      V8AtomicString(isolate, override_name),
+  };
+  v8::Local<v8::Array> data = v8::Array::New(isolate, data_items, 2);
+  return target
+      ->SetNativeDataProperty(context, V8AtomicString(isolate, prop_name),
+                               OverridePropertyGetter, nullptr, data,
+                               v8::None)
+      .FromMaybe(false);
+}
+
+// Generic callback for functions that have no original — delegates entirely
+// to the override. data: [interface_key, override_name]
+void GenericOverrideOnlyCallback(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+  v8::Local<v8::Object> global = context->Global();
+
+  v8::Local<v8::Array> data = info.Data().As<v8::Array>();
+  v8::Local<v8::String> iface_key =
+      data->Get(context, 0u).ToLocalChecked().As<v8::String>();
+  v8::Local<v8::String> override_name =
+      data->Get(context, 1u).ToLocalChecked().As<v8::String>();
+
+  v8::Local<v8::Value> co_val;
+  if (!global
+           ->Get(context, V8AtomicString(isolate, "customOverrides"))
+           .ToLocal(&co_val) ||
+      !co_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Value> iface_val;
+  if (!co_val.As<v8::Object>()
+           ->Get(context, iface_key)
+           .ToLocal(&iface_val) ||
+      !iface_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Value> override_fn_val;
+  if (!iface_val.As<v8::Object>()
+           ->Get(context, override_name)
+           .ToLocal(&override_fn_val) ||
+      !override_fn_val->IsFunction()) {
+    return;
+  }
+
+  int argc = info.Length();
+  std::vector<v8::Local<v8::Value>> argv(argc);
+  for (int i = 0; i < argc; i++) {
+    argv[i] = info[i];
+  }
+
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> result;
+  if (override_fn_val.As<v8::Function>()
+          ->Call(context, v8::Undefined(isolate), argc, argv.data())
+          .ToLocal(&result)) {
+    info.GetReturnValue().Set(result);
+  }
+}
+
+// Installs a function on target that delegates entirely to override.
+bool InstallOverrideFunction(v8::Isolate* isolate,
+                              v8::Local<v8::Context> context,
+                              v8::Local<v8::Object> target,
+                              const char* fn_name,
+                              const char* interface_key,
+                              const char* override_name,
+                              int length = 0) {
+  v8::Local<v8::Value> data_items[] = {
+      V8AtomicString(isolate, interface_key),
+      V8AtomicString(isolate, override_name),
+  };
+  v8::Local<v8::Array> data = v8::Array::New(isolate, data_items, 2);
+  v8::Local<v8::Function> fn;
+  if (!v8::Function::New(context, GenericOverrideOnlyCallback, data, length)
+           .ToLocal(&fn)) {
+    return false;
+  }
+  fn->SetName(V8AtomicString(isolate, fn_name));
+  return target->Set(context, V8AtomicString(isolate, fn_name), fn)
+      .FromMaybe(false);
+}
+
+// Wraps an existing getter (accessor property) on a prototype with override
+// logic. Uses Object.defineProperty to redefine the accessor.
+bool WrapGetterOnPrototype(v8::Isolate* isolate,
+                            v8::Local<v8::Context> context,
+                            v8::Local<v8::Object> proto,
+                            const char* prop_name,
+                            const char* interface_key,
+                            const char* override_name) {
+  v8::Local<v8::String> name_str = V8AtomicString(isolate, prop_name);
+  v8::Local<v8::Object> global = context->Global();
+
+  // Get existing property descriptor to extract the getter.
+  v8::Local<v8::Value> desc_val;
+  if (!proto->GetOwnPropertyDescriptor(context, name_str).ToLocal(&desc_val) ||
+      !desc_val->IsObject()) {
+    return false;
+  }
+  v8::Local<v8::Object> desc = desc_val.As<v8::Object>();
+  v8::Local<v8::Value> getter_val;
+  if (!desc->Get(context, V8AtomicString(isolate, "get")).ToLocal(&getter_val) ||
+      !getter_val->IsFunction()) {
+    return false;
+  }
+  v8::Local<v8::Function> original_getter = getter_val.As<v8::Function>();
+
+  // Create wrapper using GenericBuiltinWrapper.
+  v8::Local<v8::Value> data_items[] = {
+      original_getter,
+      V8AtomicString(isolate, interface_key),
+      V8AtomicString(isolate, override_name),
+  };
+  v8::Local<v8::Array> data = v8::Array::New(isolate, data_items, 3);
+
+  v8::Local<v8::Function> wrapper;
+  if (!v8::Function::New(context, GenericBuiltinWrapper, data, 0)
+           .ToLocal(&wrapper)) {
+    return false;
+  }
+
+  // Get Object.defineProperty to redefine the accessor.
+  v8::Local<v8::Value> object_val;
+  if (!global->Get(context, V8AtomicString(isolate, "Object"))
+           .ToLocal(&object_val) ||
+      !object_val->IsObject()) {
+    return false;
+  }
+  v8::Local<v8::Value> define_prop_val;
+  if (!object_val.As<v8::Object>()
+           ->Get(context, V8AtomicString(isolate, "defineProperty"))
+           .ToLocal(&define_prop_val) ||
+      !define_prop_val->IsFunction()) {
+    return false;
+  }
+
+  // Build new descriptor { get: wrapper, set: originalSetter, enumerable,
+  // configurable }.
+  v8::Local<v8::Object> new_desc = v8::Object::New(isolate);
+  new_desc->Set(context, V8AtomicString(isolate, "get"), wrapper).Check();
+  v8::Local<v8::Value> setter_val;
+  if (desc->Get(context, V8AtomicString(isolate, "set")).ToLocal(&setter_val) &&
+      setter_val->IsFunction()) {
+    new_desc->Set(context, V8AtomicString(isolate, "set"), setter_val).Check();
+  }
+  new_desc
+      ->Set(context, V8AtomicString(isolate, "enumerable"), v8::True(isolate))
+      .Check();
+  new_desc
+      ->Set(context, V8AtomicString(isolate, "configurable"),
+            v8::True(isolate))
+      .Check();
+
+  // Call Object.defineProperty(proto, name, desc).
+  v8::Local<v8::Value> args[] = {proto, name_str, new_desc};
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> result;
+  return define_prop_val.As<v8::Function>()
+      ->Call(context, object_val, 3, args)
+      .ToLocal(&result);
+}
+
