+  if (!override_fn.IsEmpty()) {
+    v8::Local<v8::Value> v8_value =
+        ToV8Traits<IDLSequence<NavigatorUABrandVersion>>::ToV8(script_state,
+                                                                result);
+    v8::Local<v8::Value> args[] = {v8_value};
+    v8::TryCatch try_catch(isolate);
+    v8::Local<v8::Value> override_result;
+    if (override_fn
+            ->Call(script_state->GetContext(), v8::Undefined(isolate), 1, args)
+            .ToLocal(&override_result)) {
+    }
+  }
+  return result;
+}
+
+const String& NavigatorUAData::platformForBinding(
+    ScriptState* script_state) const {
+  const String& result = platform();
+  if (!script_state || !script_state->ContextIsValid())
+    return result;
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+      script_state, "navigatorUAData", "platformOverride");
+  if (!override_fn.IsEmpty()) {
+    v8::Local<v8::Value> args[] = {V8String(isolate, result)};
+    v8::TryCatch try_catch(isolate);
+    v8::Local<v8::Value> override_result;
+    if (override_fn
+            ->Call(script_state->GetContext(), v8::Undefined(isolate), 1, args)
+            .ToLocal(&override_result)) {
+      if (override_result->IsString()) {
+        // platformForBinding returns a const reference to an internal member,
+        // so we can't return a modified string here. The override is used
+        // for notification only (Pattern D).
+      }
+    }
+  }
+  return result;
+}
