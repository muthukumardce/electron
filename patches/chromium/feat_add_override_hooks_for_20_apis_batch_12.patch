+const Vector<String>& NavigatorLanguage::languagesForBinding(
+    ScriptState* script_state) {
+  const Vector<String>& result = languages();
+  if (!script_state || !script_state->ContextIsValid())
+    return result;
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+      script_state, "navigator", "languagesOverride");
+  if (!override_fn.IsEmpty()) {
+    v8::Local<v8::Array> v8_array =
+        v8::Array::New(isolate, static_cast<int>(result.size()));
+    for (wtf_size_t i = 0; i < result.size(); ++i) {
+      v8_array
+          ->Set(script_state->GetContext(), i,
+                V8String(isolate, result[i]))
+          .Check();
+    }
+    v8::Local<v8::Value> args[] = {v8_array};
+    v8::TryCatch try_catch(isolate);
+    v8::Local<v8::Value> override_result;
+    if (override_fn
+            ->Call(script_state->GetContext(), v8::Undefined(isolate), 1, args)
+            .ToLocal(&override_result)) {
+    }
+  }
+  return result;
+}
+
