+// Dynamic font allow list from session config.
+// When non-empty, replaces the static kAllowedFonts for font enumeration
+// fingerprint protection. All entries stored lowercase for case-insensitive
+// comparison.
+static HashSet<String>& GetDynamicFontAllowList() {
+  DEFINE_STATIC_LOCAL(HashSet<String>, dynamic_list, ());
+  return dynamic_list;
+}
+
+static bool g_has_dynamic_font_allow_list = false;
+
+void FontCache::SetFontAllowList(const Vector<String>& allow_list) {
+  auto& dynamic_list = GetDynamicFontAllowList();
+  dynamic_list.clear();
+  if (allow_list.empty()) {
+    g_has_dynamic_font_allow_list = false;
+    return;
+  }
+  for (const String& font : allow_list) {
+    dynamic_list.insert(font.LowerASCII());
+  }
+  // Always allow generic CSS font families.
+  dynamic_list.insert(String("sans-serif"));
+  dynamic_list.insert(String("serif"));
+  dynamic_list.insert(String("monospace"));
+  dynamic_list.insert(String("cursive"));
+  dynamic_list.insert(String("fantasy"));
+  dynamic_list.insert(String("system-ui"));
+  dynamic_list.insert(String("-apple-system"));
+  dynamic_list.insert(String("blinkmacsystemfont"));
+  g_has_dynamic_font_allow_list = true;
+}
+
+void FontCache::ClearFontAllowList() {
+  GetDynamicFontAllowList().clear();
+  g_has_dynamic_font_allow_list = false;
+}
