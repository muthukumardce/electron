+
+// Returns the UAOverrideValues_Storage for the current execution context's
+// Agent cluster. Returns nullptr if no overrides are set or if the storage
+// has no overrides active.
+//
+// Usage in ForBinding hooks:
+//   auto* storage = GetSessionOverrideStorage(script_state);
+//   if (storage && storage->override_screen_width.has_value() &&
+//       !storage->IsOverrideDisabled("screen.width")) {
+//     return storage->override_screen_width.value();
+//   }
+//   return original_value;
+inline UAOverrideValues_Storage* GetSessionOverrideStorage(
+    ScriptState* script_state) {
+  if (!script_state || !script_state->ContextIsValid())
+    return nullptr;
+
+  ExecutionContext* context = ExecutionContext::From(script_state);
+  if (!context)
+    return nullptr;
+
+  base::UnguessableToken cluster_id = context->GetAgentClusterID();
+  UAOverrideValues_Storage* storage =
+      UAOverrideManager::GetInstance().GetStorageForCluster(cluster_id);
+
+  if (!storage || !storage->has_override)
+    return nullptr;
+
+  return storage;
+}
+
+// Deterministic seeded noise function. Returns a value in [0.0, 1.0).
+// Uses the same algorithm as the JS seed-utils.ts for consistency.
+inline double SeededNoise(double seed, int index) {
+  double combined = seed + static_cast<double>(index);
+  double x = std::sin(combined) * 10000.0;
+  return x - std::floor(x);
+}
+
+// Convenience: get an int override if set and not disabled.
+// Returns true and sets |out| if the override is active.
+inline bool GetIntOverride(UAOverrideValues_Storage* storage,
+                           const std::optional<int>& field,
+                           const char* disable_path,
+                           int& out) {
+  if (!storage || !field.has_value())
+    return false;
+  if (storage->IsOverrideDisabled(String(disable_path)))
+    return false;
+  out = field.value();
+  return true;
+}
+
+// Convenience: get a double override if set and not disabled.
+inline bool GetDoubleOverride(UAOverrideValues_Storage* storage,
+                              const std::optional<double>& field,
+                              const char* disable_path,
+                              double& out) {
+  if (!storage || !field.has_value())
+    return false;
+  if (storage->IsOverrideDisabled(String(disable_path)))
+    return false;
+  out = field.value();
+  return true;
+}
+
+// Convenience: get a String override if set and not disabled.
+inline bool GetStringOverride(UAOverrideValues_Storage* storage,
+                              const std::optional<String>& field,
+                              const char* disable_path,
+                              String& out) {
+  if (!storage || !field.has_value())
+    return false;
+  if (storage->IsOverrideDisabled(String(disable_path)))
+    return false;
+  out = field.value();
+  return true;
+}
+
+// Convenience: get a bool override if set and not disabled.
+inline bool GetBoolOverride(UAOverrideValues_Storage* storage,
+                            const std::optional<bool>& field,
+                            const char* disable_path,
+                            bool& out) {
+  if (!storage || !field.has_value())
+    return false;
+  if (storage->IsOverrideDisabled(String(disable_path)))
+    return false;
+  out = field.value();
+  return true;
+}
+
+// Convenience: get an unsigned override if set and not disabled.
+inline bool GetUnsignedOverride(UAOverrideValues_Storage* storage,
+                                const std::optional<unsigned>& field,
+                                const char* disable_path,
+                                unsigned& out) {
+  if (!storage || !field.has_value())
+    return false;
+  if (storage->IsOverrideDisabled(String(disable_path)))
+    return false;
+  out = field.value();
+  return true;
+}
+
+// Convenience: get a uint64 override if set and not disabled.
+inline bool GetUint64Override(UAOverrideValues_Storage* storage,
+                              const std::optional<uint64_t>& field,
+                              const char* disable_path,
+                              uint64_t& out) {
+  if (!storage || !field.has_value())
+    return false;
+  if (storage->IsOverrideDisabled(String(disable_path)))
+    return false;
+  out = field.value();
