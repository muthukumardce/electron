             broadcast->UpdateCanvasNoiseToken(canvas_noise_token);
           }
         });
+
+    // Send session-level fingerprint overrides to the renderer.
+    // This populates the renderer-side UAOverrideManager so all ForBinding
+    // hooks can read override values directly from C++ storage.
+    BrowserContext* browser_context =
+        frame_tree_node()->navigator().controller().GetBrowserContext();
+    auto fingerprint_config =
+        GetContentClient()->browser()->GetFingerprintConfig(browser_context);
+    if (fingerprint_config) {
+      frame_tree()->root()->render_manager()->ExecutePageBroadcastMethod(
+          [&fingerprint_config](RenderViewHostImpl* rvh) {
+            if (auto& broadcast = rvh->GetAssociatedPageBroadcast()) {
+              broadcast->UpdateFingerprintConfig(
+                  std::move(fingerprint_config));
+            }
+          });
+    }
