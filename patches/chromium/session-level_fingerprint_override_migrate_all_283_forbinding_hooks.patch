+// Copyright (c) 2026 FalconBrowser.
+// Session-level fingerprint override helpers for ForBinding hooks.
+// This header provides the bridge between ForBinding hooks and the
+// UAOverrideManager C++ storage, eliminating the need for JS callbacks
+// via window.customOverrides.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_SESSION_OVERRIDE_HELPERS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_SESSION_OVERRIDE_HELPERS_H_
+
+#include <cmath>
+
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/frame/navigator_ua_data.h"
+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+
