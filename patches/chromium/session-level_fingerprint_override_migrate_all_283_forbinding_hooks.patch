+// Helper to parse a double from a WTF::String.
+std::optional<double> ParseDouble(const String& s) {
+  bool ok = false;
+  double val = s.ToDouble(&ok);
+  return ok ? std::optional<double>(val) : std::nullopt;
+}
+
+// Helper to parse an int from a WTF::String.
+std::optional<int> ParseInt(const String& s) {
+  bool ok = false;
+  int val = s.ToInt(&ok);
+  return ok ? std::optional<int>(val) : std::nullopt;
+}
+
+// Helper to parse an unsigned from a WTF::String.
+std::optional<unsigned> ParseUnsigned(const String& s) {
+  bool ok = false;
+  unsigned val = s.ToUInt(&ok);
+  return ok ? std::optional<unsigned>(val) : std::nullopt;
+}
+
+// Helper to parse a uint64 from a WTF::String.
+std::optional<uint64_t> ParseUint64(const String& s) {
+  bool ok = false;
+  double d = s.ToDouble(&ok);
+  if (!ok || d < 0)
+    return std::nullopt;
+  return static_cast<uint64_t>(d);
+}
+
+// Helper to parse a bool from a WTF::String.
+std::optional<bool> ParseBool(const String& s) {
+  if (s == "true" || s == "1")
+    return true;
+  if (s == "false" || s == "0")
+    return false;
+  return std::nullopt;
+}
+
+// Helper to parse a comma-separated list of strings.
+Vector<String> ParseStringList(const String& s) {
+  Vector<String> result;
+  if (s.empty())
+    return result;
+  s.Split(',', result);
+  return result;
+}
+
+// Helper to parse brand pairs: "brand1|ver1,brand2|ver2"
+Vector<std::pair<String, String>> ParseBrandPairs(const String& s) {
+  Vector<std::pair<String, String>> result;
+  if (s.empty())
+    return result;
+  Vector<String> pairs;
+  s.Split(',', pairs);
+  for (const auto& pair : pairs) {
+    wtf_size_t sep = pair.find('|');
+    if (sep != kNotFound) {
+      result.push_back(std::make_pair(
+          pair.Left(sep), pair.Substring(sep + 1)));
+    }
+  }
+  return result;
+}
