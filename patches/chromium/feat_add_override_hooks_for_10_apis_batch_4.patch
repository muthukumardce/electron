+String CSSStyleDeclaration::getPropertyValueForBinding(
+    ScriptState* script_state,
+    const String& property_name) {
+  String value = getPropertyValue(property_name);
+  if (!script_state || !script_state->ContextIsValid())
+    return value;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+
+  v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+      script_state, "cssStyleDeclaration", "getPropertyValueOverride");
+  if (override_fn.IsEmpty())
+    return value;
+
+  v8::Local<v8::Context> context = script_state->GetContext();
+  v8::Local<v8::Value> argv[] = {V8String(isolate, value)};
+  v8::Local<v8::Value> override_result;
+  if (!V8ScriptRunner::CallFunction(
+           override_fn, ExecutionContext::From(script_state),
+           context->Global(), 1, argv, isolate)
+           .ToLocal(&override_result))
+    return value;
+
+  if (override_result->IsNullOrUndefined())
+    return value;
+  v8::Local<v8::String> override_string;
+  if (!override_result->ToString(context).ToLocal(&override_string))
+    return value;
+  return ToCoreString(isolate, override_string);
+}
