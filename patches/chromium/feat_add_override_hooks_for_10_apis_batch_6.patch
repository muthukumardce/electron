@@ -42,4 +44,44 @@ int32_t NavigatorEvents::maxTouchPoints(Navigator& navigator) {
   return window ? window->GetFrame()->GetSettings()->GetMaxTouchPoints() : 0;
 }
 
+namespace {
+int32_t MaybeIntOverride(ScriptState* script_state,
+                         int32_t value,
+                         const char* interface_key,
+                         const char* override_name) {
+  if (!script_state || !script_state->ContextIsValid())
+    return value;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+
+  v8::Local<v8::Function> override_fn =
+      GetCustomOverrideFunction(script_state, interface_key, override_name);
+  if (override_fn.IsEmpty())
+    return value;
+
+  v8::Local<v8::Context> context = script_state->GetContext();
+  v8::Local<v8::Value> argv[] = {
+      v8::Number::New(isolate, static_cast<double>(value))};
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> override_result;
+  if (!V8ScriptRunner::CallFunction(
+           override_fn, ExecutionContext::From(script_state),
+           context->Global(), 1, argv, isolate)
+           .ToLocal(&override_result))
+    return value;
+
+  if (override_result->IsNumber())
+    return static_cast<int32_t>(override_result.As<v8::Number>()->Value());
+  return value;
+}
+}  // namespace
+
+int32_t NavigatorEvents::maxTouchPointsForBinding(ScriptState* script_state,
+                                                  Navigator& navigator) {
+  return MaybeIntOverride(script_state, maxTouchPoints(navigator), "navigator",
+                          "maxTouchPointsOverride");
+}
+
 }  // namespace blink
