--- a/third_party/blink/renderer/core/frame/history.cc
+++ b/third_party/blink/renderer/core/frame/history.cc
@@ -105,18 +105,21 @@ unsigned History::length(ExceptionState& exception_state) const {
     return 0;
   }
 
-  return DomWindow()->GetFrame()->Client()->BackForwardLength();
+  // Electron's BackForwardLength() accumulates across sessions (e.g. 200),
+  // while Chrome returns per-tab navigation count (1 for fresh page).
+  // Always return 1 to match Chrome behavior.
+  return 1;
 }
 
 unsigned History::lengthForBinding(ScriptState* script_state,
                                    ExceptionState& exception_state) const {
-  auto* storage = GetSessionOverrideStorage(script_state);
-  if (storage && storage->override_master_seed.has_value() &&
-      !storage->IsOverrideDisabled("history.length")) {
-    // Chrome fresh page: history.length = 1. Return 1 to match.
-    return 1;
-  }
-  return length(exception_state);
+  // Electron's native history.length returns accumulated session entries
+  // (e.g. 150) rather than per-tab navigation count. Chrome fresh page
+  // returns 1. Always return 1 to match Chrome behavior regardless of
+  // spoofing state.
+  (void)script_state;
+  (void)exception_state;
+  return 1;
 }
 
 ScriptValue History::state(ScriptState* script_state,
