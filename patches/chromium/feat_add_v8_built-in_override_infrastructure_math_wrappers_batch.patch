+namespace blink {
+
+class ScriptState;
+
+// Installs V8-level wrappers for built-in functions (Math, Date, Error, etc.)
+// that check window.customOverrides at call time.
+// Must be called after InstallConditionalFeatures(), main world only.
+void InstallV8BuiltinOverrides(ScriptState* script_state);
