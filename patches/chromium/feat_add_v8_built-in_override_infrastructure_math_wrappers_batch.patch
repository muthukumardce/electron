index 0000000000000000000000000000000000000000..0b28acb58be03003c4c616d8a080bd92613a9e70
--- /dev/null
+++ b/third_party/blink/renderer/bindings/core/v8/v8_builtin_overrides.cc
@@ -0,0 +1,196 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/bindings/core/v8/v8_builtin_overrides.h"
+
+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+#include "third_party/blink/renderer/platform/bindings/v8_binding.h"
+#include "v8/include/v8.h"
+
+namespace blink {
+namespace {
+
+// Data array indices for wrapper function metadata.
+constexpr int kDataOriginalFn = 0;
+constexpr int kDataInterfaceKey = 1;
+constexpr int kDataOverrideName = 2;
+
+// Generic wrapper callback for V8 built-in functions.
+// Called when a wrapped function (e.g. Math.cos) is invoked from JS.
+// Calls the original, then checks window.customOverrides for an override.
+void GenericBuiltinWrapper(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+
+  v8::Local<v8::Array> data = info.Data().As<v8::Array>();
+  v8::Local<v8::Function> original_fn =
+      data->Get(context, kDataOriginalFn).ToLocalChecked().As<v8::Function>();
+
+  // Forward all arguments to the original function.
+  int argc = info.Length();
+  std::vector<v8::Local<v8::Value>> argv(argc);
+  for (int i = 0; i < argc; i++) {
+    argv[i] = info[i];
+  }
+
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> result;
+  if (!original_fn->Call(context, info.This(), argc, argv.data())
+           .ToLocal(&result)) {
+    if (try_catch.HasCaught()) {
+      try_catch.ReThrow();
+    }
+    return;
+  }
+
+  // Look up override: window.customOverrides[interfaceKey][overrideName]
+  v8::Local<v8::Object> global = context->Global();
+  v8::Local<v8::Value> custom_overrides;
+  if (!global
+           ->Get(context, V8AtomicString(isolate, "customOverrides"))
+           .ToLocal(&custom_overrides) ||
+      !custom_overrides->IsObject()) {
+    info.GetReturnValue().Set(result);
+    return;
+  }
+
+  v8::Local<v8::String> interface_key =
+      data->Get(context, kDataInterfaceKey).ToLocalChecked().As<v8::String>();
+  v8::Local<v8::Value> iface;
+  if (!custom_overrides.As<v8::Object>()
+           ->Get(context, interface_key)
+           .ToLocal(&iface) ||
+      !iface->IsObject()) {
+    info.GetReturnValue().Set(result);
+    return;
+  }
+
+  v8::Local<v8::String> override_name =
+      data->Get(context, kDataOverrideName).ToLocalChecked().As<v8::String>();
+  v8::Local<v8::Value> override_fn_val;
+  if (!iface.As<v8::Object>()
+           ->Get(context, override_name)
+           .ToLocal(&override_fn_val) ||
+      !override_fn_val->IsFunction()) {
+    info.GetReturnValue().Set(result);
+    return;
+  }
+
+  // Call override with (originalResult, ...originalArgs).
+  v8::Local<v8::Function> override_fn = override_fn_val.As<v8::Function>();
+  std::vector<v8::Local<v8::Value>> override_argv(argc + 1);
+  override_argv[0] = result;
+  for (int i = 0; i < argc; i++) {
+    override_argv[i + 1] = info[i];
+  }
+
+  v8::TryCatch override_try_catch(isolate);
+  v8::Local<v8::Value> override_result;
+  if (!override_fn
+           ->Call(context, v8::Undefined(isolate), argc + 1,
+                  override_argv.data())
+           .ToLocal(&override_result)) {
+    // Override threw — fall back to original result.
+    info.GetReturnValue().Set(result);
+    return;
+  }
+
+  if (!override_result->IsNullOrUndefined()) {
+    info.GetReturnValue().Set(override_result);
+  } else {
+    info.GetReturnValue().Set(result);
+  }
+}
+
+// Wraps a single function on a target object with GenericBuiltinWrapper.
+// Returns true on success.
+bool WrapFunctionOnObject(v8::Isolate* isolate,
+                          v8::Local<v8::Context> context,
+                          v8::Local<v8::Object> target,
+                          const char* fn_name,
+                          const char* interface_key,
+                          const char* override_name) {
+  v8::Local<v8::String> name_str = V8AtomicString(isolate, fn_name);
+  v8::Local<v8::Value> original_val;
+  if (!target->Get(context, name_str).ToLocal(&original_val) ||
+      !original_val->IsFunction()) {
+    return false;
+  }
+  v8::Local<v8::Function> original_fn = original_val.As<v8::Function>();
+
+  // Build data array: [original_fn, interface_key, override_name]
+  v8::Local<v8::Value> data_items[] = {
+      original_fn,
+      V8AtomicString(isolate, interface_key),
+      V8AtomicString(isolate, override_name),
+  };
+  v8::Local<v8::Array> data = v8::Array::New(isolate, data_items, 3);
+
+  // Get the function's formal parameter count (length property).
+  int fn_length = 0;
+  v8::Local<v8::Value> length_val;
+  if (original_fn->Get(context, V8AtomicString(isolate, "length"))
+           .ToLocal(&length_val) &&
+      length_val->IsInt32()) {
+    fn_length = length_val.As<v8::Int32>()->Value();
+  }
+
+  v8::Local<v8::Function> wrapper;
+  if (!v8::Function::New(context, GenericBuiltinWrapper, data, fn_length)
+           .ToLocal(&wrapper)) {
+    return false;
+  }
+
+  // Set function name so toString() shows the correct name.
+  wrapper->SetName(name_str);
+
+  return target->Set(context, name_str, wrapper).FromMaybe(false);
+}
+
+// Install Math function overrides.
+void InstallMathOverrides(v8::Isolate* isolate,
+                          v8::Local<v8::Context> context) {
+  v8::Local<v8::Object> global = context->Global();
+  v8::Local<v8::Value> math_val;
+  if (!global->Get(context, V8AtomicString(isolate, "Math"))
+           .ToLocal(&math_val) ||
+      !math_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Object> math = math_val.As<v8::Object>();
+
+  static const struct {
+    const char* fn_name;
+    const char* override_name;
+  } kMathFns[] = {
+      {"acos", "acosOverride"},   {"acosh", "acoshOverride"},
+      {"asin", "asinOverride"},   {"asinh", "asinhOverride"},
+      {"atan", "atanOverride"},   {"atanh", "atanhOverride"},
+      {"cbrt", "cbrtOverride"},   {"cos", "cosOverride"},
+      {"cosh", "coshOverride"},   {"exp", "expOverride"},
+      {"expm1", "expm1Override"}, {"log", "logOverride"},
+      {"log1p", "log1pOverride"}, {"sin", "sinOverride"},
+      {"sinh", "sinhOverride"},   {"sqrt", "sqrtOverride"},
+      {"tan", "tanOverride"},     {"tanh", "tanhOverride"},
+  };
+
+  for (const auto& fn : kMathFns) {
+    WrapFunctionOnObject(isolate, context, math, fn.fn_name, "math",
+                         fn.override_name);
+  }
+}
+
+}  // namespace
+
+void InstallV8BuiltinOverrides(ScriptState* script_state) {
+  if (!script_state || !script_state->ContextIsValid())
+    return;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::Local<v8::Context> context = script_state->GetContext();
+
+  InstallMathOverrides(isolate, context);
+}
+
+}  // namespace blink
