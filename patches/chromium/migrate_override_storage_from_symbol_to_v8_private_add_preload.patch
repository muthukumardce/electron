+// Helper: Get the V8 Private override container from the global object.
+// Returns empty handle if not found.
+v8::Local<v8::Object> GetPrivateOverrideContainer(
+    v8::Isolate* isolate,
+    v8::Local<v8::Context> context) {
+  v8::Local<v8::Private> key = v8::Private::ForApi(
+      isolate, V8AtomicString(isolate, kCustomOverridesPrivateKey));
+  v8::Local<v8::Value> container;
+  if (!context->Global()->GetPrivate(context, key).ToLocal(&container) ||
+      !container->IsObject()) {
+    return v8::Local<v8::Object>();
+  }
+  return container.As<v8::Object>();
+}
+
+// Helper: Get or create the V8 Private override container.
+v8::Local<v8::Object> GetOrCreatePrivateOverrideContainer(
+    v8::Isolate* isolate,
+    v8::Local<v8::Context> context) {
+  v8::Local<v8::Private> key = v8::Private::ForApi(
+      isolate, V8AtomicString(isolate, kCustomOverridesPrivateKey));
+  v8::Local<v8::Object> global = context->Global();
+  v8::Local<v8::Value> container;
+  if (global->GetPrivate(context, key).ToLocal(&container) &&
+      container->IsObject()) {
+    return container.As<v8::Object>();
+  }
+  v8::Local<v8::Object> new_container = v8::Object::New(isolate);
+  global->SetPrivate(context, key, new_container).Check();
+  return new_container;
+}
+
+// Helper: Look up override function from V8 Private container.
+// Shared by GenericBuiltinWrapper, GenericConstructorWrapper, etc.
+v8::Local<v8::Value> LookupOverrideFromPrivate(
+    v8::Isolate* isolate,
+    v8::Local<v8::Context> context,
+    v8::Local<v8::String> interface_key,
+    v8::Local<v8::String> override_name) {
+  v8::Local<v8::Object> container =
+      GetPrivateOverrideContainer(isolate, context);
+  if (container.IsEmpty())
+    return v8::Local<v8::Value>();
+
+  v8::Local<v8::Value> iface;
+  if (!container->Get(context, interface_key).ToLocal(&iface) ||
+      !iface->IsObject())
+    return v8::Local<v8::Value>();
+
+  v8::Local<v8::Value> override_val;
+  if (!iface.As<v8::Object>()
+           ->Get(context, override_name)
+           .ToLocal(&override_val))
+    return v8::Local<v8::Value>();
+
+  return override_val;
+}
