+// === BRIDGE FUNCTIONS ===
+// These temporary functions are installed on the global object so that preload
+// scripts can register overrides into the V8 Private container.  They are
+// deleted after preload completes, making them invisible to web content.
+
+// __ro(interfaceKey, overrideName, fn)  — register override function
+void RegisterOverrideCallback(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+
+  if (info.Length() < 3 || !info[0]->IsString() || !info[1]->IsString() ||
+      !info[2]->IsFunction())
+    return;
+
+  v8::Local<v8::Object> container =
+      GetOrCreatePrivateOverrideContainer(isolate, context);
+
+  // Get or create interface bucket.
+  v8::Local<v8::String> iface_key = info[0].As<v8::String>();
+  v8::Local<v8::Value> iface_val;
+  if (!container->Get(context, iface_key).ToLocal(&iface_val))
+    return;
+
+  v8::Local<v8::Object> iface;
+  if (iface_val->IsObject()) {
+    iface = iface_val.As<v8::Object>();
+  } else {
+    iface = v8::Object::New(isolate);
+    container->Set(context, iface_key, iface).Check();
+  }
+
+  // Store the override function.
+  iface->Set(context, info[1].As<v8::String>(), info[2]).Check();
+}
+
+// __rov(interfaceKey, overrideName, value)  — register override value
+// (for propertyExistence arrays and other non-function values)
+void RegisterOverrideValueCallback(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+
+  if (info.Length() < 3 || !info[0]->IsString() || !info[1]->IsString())
+    return;
+
+  v8::Local<v8::Object> container =
+      GetOrCreatePrivateOverrideContainer(isolate, context);
+
+  v8::Local<v8::String> iface_key = info[0].As<v8::String>();
+  v8::Local<v8::Value> iface_val;
+  if (!container->Get(context, iface_key).ToLocal(&iface_val))
+    return;
+
+  v8::Local<v8::Object> iface;
+  if (iface_val->IsObject()) {
+    iface = iface_val.As<v8::Object>();
+  } else {
+    iface = v8::Object::New(isolate);
+    container->Set(context, iface_key, iface).Check();
+  }
+
+  iface->Set(context, info[1].As<v8::String>(), info[2]).Check();
+}
+
+// __rUA(data)  — register UA data via NavigatorUAData::setUA() internally,
+// then self-destruct.
+void RegisterUACallback(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+
+  if (info.Length() < 1 || !info[0]->IsObject())
+    return;
+
+  v8::Local<v8::Object> global = context->Global();
+
+  // Find the NavigatorUAData object and call setUA() on it internally.
+  // Navigate: window.navigator.userAgentData
+  v8::Local<v8::Value> nav_val;
+  if (!global->Get(context, V8AtomicString(isolate, "navigator"))
+           .ToLocal(&nav_val) ||
+      !nav_val->IsObject())
+    return;
+
+  v8::Local<v8::Value> ua_data_val;
+  if (!nav_val.As<v8::Object>()
+           ->Get(context, V8AtomicString(isolate, "userAgentData"))
+           .ToLocal(&ua_data_val) ||
+      !ua_data_val->IsObject())
+    return;
+
+  // Get the NavigatorUAData C++ object and call setUA() directly.
+  // Since we removed setUA from IDL, we need to call the internal
+  // C++ method. We achieve this by temporarily re-exposing a hidden
+  // method on the userAgentData object that delegates to C++.
+  //
+  // Actually, the simplest approach: just put the data into the
+  // UAOverrideManager directly from here. We need the ExecutionContext.
+  ScriptState* script_state = ScriptState::ForCurrentRealm(info);
+  if (!script_state || !script_state->ContextIsValid())
+    return;
+
+  ExecutionContext* execution_context = ExecutionContext::From(script_state);
+  if (!execution_context)
+    return;
+
+  // Navigate to the NavigatorUAData wrapper and unwrap it.
+  NavigatorUAData* ua_data_obj =
+      V8NavigatorUAData::ToWrappable(isolate, ua_data_val);
+  if (!ua_data_obj)
+    return;
+
+  // Build a UAOverrideValues from the JS object.
+  // We need to use the generated V8 binding to convert.
+  ExceptionState exception_state(isolate, ExceptionContext(
+      v8::ExceptionContext::kOperation, "NavigatorUAData", "setUA"));
+  UAOverrideValues* override_values =
+      NativeValueTraits<UAOverrideValues>::NativeValue(
+          isolate, info[0], exception_state);
+  if (exception_state.HadException())
+    return;
+
+  ua_data_obj->setUA(override_values);
+
+  // Self-destruct: delete __rUA from global.
+  std::ignore = global->Delete(context, V8AtomicString(isolate, "__rUA"));
+}
+
+// Install the __ro, __rov, __rUA bridge functions on the global object.
+void InstallOverrideRegistrationBridge(v8::Isolate* isolate,
+                                        v8::Local<v8::Context> context) {
+  v8::Local<v8::Object> global = context->Global();
+
+  // __ro(iface, name, fn)
+  v8::Local<v8::Function> ro_fn =
+      v8::Function::New(context, RegisterOverrideCallback).ToLocalChecked();
+  v8::PropertyDescriptor ro_desc(ro_fn, false);
+  ro_desc.set_enumerable(false);
+  ro_desc.set_configurable(true);
+  global->DefineProperty(context, V8AtomicString(isolate, "__ro"), ro_desc)
+      .Check();
+
+  // __rov(iface, name, value)
+  v8::Local<v8::Function> rov_fn =
+      v8::Function::New(context, RegisterOverrideValueCallback)
+          .ToLocalChecked();
+  v8::PropertyDescriptor rov_desc(rov_fn, false);
+  rov_desc.set_enumerable(false);
+  rov_desc.set_configurable(true);
+  global->DefineProperty(context, V8AtomicString(isolate, "__rov"), rov_desc)
+      .Check();
+
+  // __rUA(data) — self-destructs after first call
+  v8::Local<v8::Function> rua_fn =
+      v8::Function::New(context, RegisterUACallback).ToLocalChecked();
+  v8::PropertyDescriptor rua_desc(rua_fn, false);
+  rua_desc.set_enumerable(false);
+  rua_desc.set_configurable(true);
+  global->DefineProperty(context, V8AtomicString(isolate, "__rUA"), rua_desc)
+      .Check();
+}
+
