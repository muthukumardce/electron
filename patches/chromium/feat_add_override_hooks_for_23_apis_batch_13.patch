+String HTMLFormElement::autocompleteForBinding(ScriptState* script_state) const {
+  AtomicString value = FastGetAttribute(html_names::kAutocompleteAttr);
+  // ReflectOnly=("on","off"), ReflectMissing="on", ReflectInvalid="on"
+  String result;
+  if (EqualIgnoringASCIICase(value, "off")) {
+    result = "off";
+  } else {
+    result = "on";
+  }
+  if (script_state && script_state->ContextIsValid()) {
+    v8::Isolate* isolate = script_state->GetIsolate();
+    v8::HandleScope handle_scope(isolate);
+    v8::Local<v8::Function> override_fn = GetCustomOverrideFunction(
+        script_state, "htmlFormElement", "autocompleteOverride");
+    if (!override_fn.IsEmpty()) {
+      v8::Local<v8::Value> args[] = {V8String(isolate, result)};
+      v8::TryCatch try_catch(isolate);
+      v8::Local<v8::Value> override_result;
+      if (override_fn
+              ->Call(script_state->GetContext(), v8::Undefined(isolate), 1, args)
+              .ToLocal(&override_result)) {
+        if (override_result->IsString()) {
+          return ToCoreString(isolate, override_result.As<v8::String>());
+        }
+      }
+    }
+  }
+  return result;
+}
+
+void HTMLFormElement::setAutocompleteForBinding(ScriptState*,
+                                                const String& value) {
+  setAttribute(html_names::kAutocompleteAttr, AtomicString(value));
+}
