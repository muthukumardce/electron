From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Muthukumar <mk@verveflux.com>
Date: Thu, 19 Feb 2026 15:41:04 +0530
Subject: Hardcode navigator.webdriver to false to prevent automation detection

Replace the runtime AutomationControlled flag check and probe-based
override in Navigator::webdriver() with a direct false return. This
prevents sites from detecting Electron as an automated browser via
the navigator.webdriver property.

diff --git a/third_party/blink/renderer/core/frame/navigator.cc b/third_party/blink/renderer/core/frame/navigator.cc
index f8e3bb7712d31fd083082990e0bcb912097bd11f..a7f05a4924781af454e11568cb819e500945bd26 100644
--- a/third_party/blink/renderer/core/frame/navigator.cc
+++ b/third_party/blink/renderer/core/frame/navigator.cc
@@ -105,12 +105,7 @@ bool Navigator::cookieEnabled() const {
 }
 
 bool Navigator::webdriver() const {
-  if (RuntimeEnabledFeatures::AutomationControlledEnabled())
-    return true;
-
-  bool automation_enabled = false;
-  probe::ApplyAutomationOverride(GetExecutionContext(), automation_enabled);
-  return automation_enabled;
+  return false;
 }
 
 String Navigator::GetAcceptLanguages() {
