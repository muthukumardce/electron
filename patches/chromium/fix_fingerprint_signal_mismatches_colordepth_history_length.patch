diff --git a/third_party/blink/renderer/core/frame/session_override_helpers.h b/third_party/blink/renderer/core/frame/session_override_helpers.h
index 9dd7d60c2987aba34caf28ef5e972b0ad10cd4ed..1f65a54c432b124da2ecfdbe01532bdce5bb2c3f 100644
--- a/third_party/blink/renderer/core/frame/session_override_helpers.h
+++ b/third_party/blink/renderer/core/frame/session_override_helpers.h
@@ -47,7 +47,11 @@ inline UAOverrideValues_Storage* GetSessionOverrideStorage(
 
 // Deterministic seeded noise function. Returns a value in [0.0, 1.0).
 // Uses the same algorithm as the JS seed-utils.ts for consistency.
+// Returns 0.5 when seed is 0 so that callers using (SeededNoise - 0.5) * factor
+// produce exactly zero noise when no seed is configured.
 inline double SeededNoise(double seed, int index) {
+  if (seed == 0.0)
+    return 0.5;
   double combined = seed + static_cast<double>(index);
   double x = std::sin(combined) * 10000.0;
   return x - std::floor(x);
