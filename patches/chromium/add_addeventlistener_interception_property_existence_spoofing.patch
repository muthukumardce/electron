+String LocalDOMWindow::doNotTrackForBinding(ScriptState* script_state) const {
+  String value;
+  if (GetFrame()) {
+    value = GetFrame()->Client()->DoNotTrackValue();
+  }
+  if (!script_state || !script_state->ContextIsValid())
+    return value;
+
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  ScriptState::Scope scope(script_state);
+
+  v8::Local<v8::Function> override_fn =
+      GetCustomOverrideFunction(script_state, "window", "doNotTrackOverride");
+  if (override_fn.IsEmpty())
+    return value;
+
+  v8::Local<v8::Context> context = script_state->GetContext();
+  v8::Local<v8::Value> argv[] = {
+      value.IsNull() ? v8::Local<v8::Value>(v8::Null(isolate))
+                     : v8::Local<v8::Value>(V8String(isolate, value))};
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> result;
+  if (!override_fn->Call(context, context->Global(), 1, argv)
+           .ToLocal(&result))
+    return value;
+  if (result->IsNullOrUndefined())
+    return value;
+  v8::Local<v8::String> result_str;
+  if (!result->ToString(context).ToLocal(&result_str))
+    return value;
+  return ToCoreString(isolate, result_str);
+}
