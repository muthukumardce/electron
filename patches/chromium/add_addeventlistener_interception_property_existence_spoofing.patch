+// Pattern Y: Property existence spoofing.
+// Reads window.customOverrides.propertyExistence and deletes properties from
+// window (globals) and Navigator.prototype based on arrays in that object.
+static void InstallPropertyExistenceOverrides(v8::Isolate* isolate,
+                                               v8::Local<v8::Context> context) {
+  v8::Local<v8::Object> global = context->Global();
+
+  v8::Local<v8::Value> co_val;
+  if (!global->Get(context, V8AtomicString(isolate, "customOverrides"))
+           .ToLocal(&co_val) ||
+      !co_val->IsObject()) {
+    return;
+  }
+
+  v8::Local<v8::Value> pe_val;
+  if (!co_val.As<v8::Object>()
+           ->Get(context, V8AtomicString(isolate, "propertyExistence"))
+           .ToLocal(&pe_val) ||
+      !pe_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Object> pe = pe_val.As<v8::Object>();
+
+  auto delete_from_array = [&](v8::Local<v8::Object> target,
+                                const char* array_key) {
+    v8::Local<v8::Value> arr_val;
+    if (!pe->Get(context, V8AtomicString(isolate, array_key))
+             .ToLocal(&arr_val) ||
+        !arr_val->IsArray()) {
+      return;
+    }
+    v8::Local<v8::Array> arr = arr_val.As<v8::Array>();
+    for (uint32_t i = 0; i < arr->Length(); i++) {
+      v8::Local<v8::Value> name_val;
+      if (arr->Get(context, i).ToLocal(&name_val) && name_val->IsString()) {
+        std::ignore = target->Delete(context, name_val.As<v8::String>());
+      }
+    }
+  };
+
+  // Delete window globals (constructors like OrientationSensor, etc.)
+  delete_from_array(global, "window");
+
+  // Delete Navigator.prototype properties (bluetooth, usb, hid, etc.)
+  v8::Local<v8::Value> nav_ctor_val;
+  if (global->Get(context, V8AtomicString(isolate, "Navigator"))
+          .ToLocal(&nav_ctor_val) &&
+      nav_ctor_val->IsFunction()) {
+    v8::Local<v8::Value> nav_proto_val;
+    if (nav_ctor_val.As<v8::Function>()
+            ->Get(context, V8AtomicString(isolate, "prototype"))
+            .ToLocal(&nav_proto_val) &&
+        nav_proto_val->IsObject()) {
+      delete_from_array(nav_proto_val.As<v8::Object>(), "navigator");
+    }
+  }
+
+  // Delete Document.prototype properties if specified
+  v8::Local<v8::Value> doc_ctor_val;
+  if (global->Get(context, V8AtomicString(isolate, "Document"))
+          .ToLocal(&doc_ctor_val) &&
+      doc_ctor_val->IsFunction()) {
+    v8::Local<v8::Value> doc_proto_val;
+    if (doc_ctor_val.As<v8::Function>()
+            ->Get(context, V8AtomicString(isolate, "prototype"))
+            .ToLocal(&doc_proto_val) &&
+        doc_proto_val->IsObject()) {
+      delete_from_array(doc_proto_val.As<v8::Object>(), "document");
+    }
+  }
+}
+
+// PostMessage wrappers: wrap postMessage on Worker.prototype,
+// BroadcastChannel.prototype, and MessagePort.prototype (covers
+// SharedWorker.port and MessageChannel.port1/port2).
+static void InstallPostMessageOverrides(v8::Isolate* isolate,
+                                         v8::Local<v8::Context> context) {
+  v8::Local<v8::Object> global = context->Global();
+
+  struct ProtoWrap {
+    const char* ctor_name;
+    const char* interface_key;
+    const char* override_name;
+  };
+  static constexpr ProtoWrap kWraps[] = {
+      {"Worker", "window", "workerPostMessageOverride"},
+      {"BroadcastChannel", "window", "broadcastChannelPostMessageOverride"},
+      {"MessagePort", "window", "messagePortPostMessageOverride"},
+  };
+
+  for (const auto& w : kWraps) {
+    v8::Local<v8::Value> ctor_val;
+    if (!global->Get(context, V8AtomicString(isolate, w.ctor_name))
+             .ToLocal(&ctor_val) ||
+        !ctor_val->IsFunction()) {
+      continue;
+    }
+    v8::Local<v8::Value> proto_val;
+    if (!ctor_val.As<v8::Function>()
+             ->Get(context, V8AtomicString(isolate, "prototype"))
+             .ToLocal(&proto_val) ||
+        !proto_val->IsObject()) {
+      continue;
+    }
+    WrapFunctionOnObject(isolate, context, proto_val.As<v8::Object>(),
+                         "postMessage", w.interface_key, w.override_name);
+  }
+}
+
 }  // namespace
 
